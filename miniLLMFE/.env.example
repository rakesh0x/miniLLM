# Where the Next.js route handlers find the miniLLM backend.
# Required in production. On Vercel set it as a server-side env var:
#   vercel env add BACKEND_URL production
# Every /api/* route proxies here, so the frontend never talks to the database
# or to the model provider directly. There is no safe default for this — the
# fallback below is a development convenience, not a production value.
BACKEND_URL=http://127.0.0.1:8000

# Base URL shown in the API keys dialog's copyable usage snippet. This one is
# read in the browser, so it must be NEXT_PUBLIC_-prefixed. It is cosmetic: it
# only changes the text the user copies.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Thread persistence via assistant-ui cloud. Unset means threads live in
# memory only and are lost on reload. Deliberately off: cloud threads would
# send conversation history to a third party, which is a decision to make
# deliberately, not by default.
# NEXT_PUBLIC_ASSISTANT_BASE_URL=

# NOTE: the assistant-ui starter ships an OPENAI_API_KEY placeholder here.
# It is not used — the frontend proxies to the backend and never calls a
# model provider. The backend holds GROQ_API_KEY instead.
