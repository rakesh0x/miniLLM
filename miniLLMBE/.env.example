# Backend configuration. Copy to .env and adjust as needed.
# Defaults (without a .env) point at a local Homebrew Postgres instance.

# Connection URL. Hosted providers need ?sslmode=require, e.g.
# postgresql+psycopg://user:password@db.example.com:5432/minillm?sslmode=require
#
# --- Region matters more than anything else here ---
# A chat request issues ~8 statements, so database latency is multiplied by
# that before the model is called. Measured from this machine (India):
#
#   region            median query   p90       12 concurrent chats
#   ap-southeast-1      96ms         101ms     6.4s
#   us-east-2           280ms        496ms     25.0s
#   local postgres      0.1ms        0.1ms     0.1s
#
# Use the *pooled* endpoint (`-pooler` in the hostname): it multiplexes many
# client connections over few server connections, which matters because the
# database's connection limit is usually much lower than the app pool size.
# Check yours any time with:  .venv/bin/python scripts/bench_db.py "<dsn>"
DATABASE_URL=postgresql+psycopg://rakesh@127.0.0.1:5432/minillm

# Prefix for generated API keys.
KEY_PREFIX=mnl_

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Postgres connection pool. Ignored by SQLite, which uses NullPool.
# Keep pool_size + max_overflow under the database's connection allowance; with
# a pooled endpoint the ceiling is generous, but a pool that runs out turns
# concurrency into a 30s wait that reads to the client as a hang.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Credits ---
# TTL on a credit allocation. A top-up always replaces it.
CREDIT_TTL_DAYS=30

# TTL on an in-flight reservation. Credits held for work that never settles
# are reclaimed automatically after this, so a crashed caller cannot lock
# credits forever.
RESERVATION_TTL_SECONDS=600
RESERVATION_RECLAIM_LIMIT=100

# How often the reclaim sweep may run, at most, per key. Each sweep is a
# query, so on a high-latency database it must not run on every request.
RESERVATION_RECLAIM_INTERVAL_SECONDS=60

# How stale `last_used_at` may get before it is written again. 0 stamps on
# every authenticated request, which is one write per request.
LAST_USED_STAMP_SECONDS=60

# Cost charged by the demo metered endpoint, POST /usage/record.
CREDITS_PER_USAGE=1

# --- LLM chat (Groq Cloud) ---
# Credentials for the OpenAI-compatible Groq API. Left empty, POST /chat
# answers 503 — the rest of the API is unaffected.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Fallback chain, tried in order. A model that refuses the request before any
# token streams (429 rate limit, timeout, upstream 5xx) hands the request to
# the next model; once tokens are flowing a failure aborts instead of splicing
# two models' answers into one message.
LLM_MODEL_CHAIN=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60

# Metering: credits charged per 1K tokens the provider reports. A request
# reserves an upper bound (estimated prompt + LLM_MAX_TOKENS) before streaming,
# then settles the exact cost; the unused part returns to available.
CREDITS_PER_1K_TOKENS=1

# Context bounds, so one request cannot meter an unbounded prompt.
LLM_MAX_HISTORY_MESSAGES=50
LLM_MAX_MESSAGE_CHARS=8000

# Optional system prompt prepended to every conversation. Leaving this empty
# *uses* the built-in persona (see guardrails.py); setting it *replaces* that
# persona, which also disables the identity half of the output filter.
LLM_SYSTEM_PROMPT=

# --- Response cache ---
# Exact-match cache of completed answers. A hit replays the stored answer and
# its original charge, so billing is identical to a fresh request.
CACHE_ENABLED=true

# "key" keeps entries private per API key (the safe default). "global" shares
# identical prompts across keys — only enable it if your prompts carry no
# user-specific data.
CACHE_SCOPE=key

CACHE_TTL_SECONDS=86400

# Footprint caps. Least-recently-hit entries go first.
CACHE_MAX_ENTRIES_PER_KEY=200
CACHE_MAX_ENTRIES=10000

# Answers longer than this are not stored.
CACHE_MAX_RESPONSE_CHARS=20000

# Replay granularity on a cache hit, in characters. Larger looks smoother;
# smaller gets the first token out sooner.
CACHE_STREAM_CHUNK_CHARS=32

# How many stores between eviction sweeps. 0 disables the sweep entirely and
# leaves it to POST /cache/cleanup. Each sweep costs several round trips.
CACHE_EVICT_EVERY=100

# How a cache hit is billed: "metered" replays the recorded charge (identical
# to a fresh request), "flat" charges CACHE_HIT_CREDITS, "free" charges
# nothing. Do not use "free" — a client can repeat one prompt to farm output.
CACHE_HIT_MODE=metered
CACHE_HIT_CREDITS=1

# --- Guardrails ---
# Layer 1: the persona in guardrails.py. Disable it if you supply your own
# system prompt above — but then identity disclosure is your prompt's problem.
GUARDRAIL_PERSONA=true

# Layer 2: the output redactor, applied to every token before it reaches the
# client or the cache. Covers credentials, connection strings, and
# self-referential identity claims.
GUARDRAIL_FILTER_OUTPUT=true

# Initial grant applied when a key is created with `credits`.
DEFAULT_KEY_CREDITS=0
DEFAULT_KEY_TTL_DAYS=30
